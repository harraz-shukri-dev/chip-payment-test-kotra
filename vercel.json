{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "*.php"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index.php"
    },
    {
      "source": "/index.php",
      "destination": "/api/index.php"
    },
    {
      "source": "/product.php",
      "destination": "/api/product.php"
    },
    {
      "source": "/product",
      "destination": "/api/product.php"
    },
    {
      "source": "/checkout.php",
      "destination": "/api/checkout.php"
    },
    {
      "source": "/checkout",
      "destination": "/api/checkout.php"
    },
    {
      "source": "/thankyou.php",
      "destination": "/api/thankyou.php"
    },
    {
      "source": "/thankyou",
      "destination": "/api/thankyou.php"
    },
    {
      "source": "/failed.php",
      "destination": "/api/failed.php"
    },
    {
      "source": "/failed",
      "destination": "/api/failed.php"
    },
    {
      "source": "/callback.php",
      "destination": "/api/callback.php"
    },
    {
      "source": "/callback",
      "destination": "/api/callback.php"
    },
    {
      "source": "/webhook.php",
      "destination": "/api/webhook.php"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook.php"
    },
    {
      "source": "/debug.php",
      "destination": "/api/debug.php"
    },
    {
      "source": "/debug",
      "destination": "/api/debug.php"
    },
    {
      "source": "/api-status.php",
      "destination": "/api/api-status.php"
    },
    {
      "source": "/api-status",
      "destination": "/api/api-status.php"
    }
  ]
}
